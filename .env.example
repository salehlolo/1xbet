# ===== BETS API =====
API_BASE_URL="https://YOUR_PROVIDER_DOMAIN"
API_KEY="PUT_YOUR_API_KEY_HERE"
API_EVENTS_ENDPOINT="/events"
API_ODDS_ENDPOINT="/odds"
API_RESULTS_ENDPOINT="/results"
MOCK_MODE=0

# ===== DATABASE =====
DB_PATH="data/app.db"

# ===== TELEGRAM =====
TELEGRAM_ENABLED=1
TELEGRAM_BOT_TOKEN="PUT_YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="PUT_YOUR_CHAT_ID_OR_CHANNEL"
TELEGRAM_PARSE_MODE="Markdown"
TELEGRAM_DISABLE_WEB_PREVIEW=1
TELEGRAM_LANG="ar"
