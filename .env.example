# =========================
# BetsAPI / 1xBet Monitor
# =========================
BETS_API_BASE_URL="https://api.betsapi.com"
BETS_API_KEY="PUT_YOUR_BETS_API_KEY"
BETS_INPLAY_ENDPOINT="/v1/1xbet/inplay"
BETS_UPCOMING_ENDPOINT="/v1/1xbet/upcoming"
BETS_EVENT_ENDPOINT="/v1/1xbet/event"
BETS_RESULT_ENDPOINT="/v1/1xbet/result"

# =========================
# Core runtime
# =========================
DB_PATH="data/app.db"
SPORTS_IDS="1,3,2"
ALLOWED_MARKET_GROUPS="1X2,totals,handicap"

UPCOMING_ONLY=1
LOOKAHEAD_MINUTES=60
MIN_MINUTES_TO_KICKOFF=5

MAX_ALERTS_PER_DAY=10
MAX_EVENTS_PER_CYCLE=120
MAX_ANALYST_EVALS_PER_CYCLE=30
MIN_SCORE_THRESHOLD=0.01
MAX_OVERROUND=1.06

INPLAY_INTERVAL_SECONDS=60
UPCOMING_INTERVAL_SECONDS=120
REQUEST_TIMEOUT_SECONDS=20
CONCURRENCY_LIMIT=5

STEAM_WINDOW_MINUTES=10
STEAM_PROB_DELTA=0.03
STEAM_MIN_BOOKS=1
OUTLIER_THRESHOLD=0.05
EV_THRESHOLD=0.03
COOLDOWN_MINUTES=30

# =========================
# Telegram
# =========================
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN="PUT_YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="PUT_YOUR_TELEGRAM_CHAT_ID"
TELEGRAM_PARSE_MODE="Markdown"
